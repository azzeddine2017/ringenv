#!/usr/bin/env bash
# ringenv launcher for Linux and macOS

export RINGENV_CALLER_DIR="$(pwd)"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -f "$SCRIPT_DIR/../tools/ringpm/packages/ringenv/main.ring" ]; then
    RINGENV_DIR="$SCRIPT_DIR/../tools/ringpm/packages/ringenv"
elif [ -f "$SCRIPT_DIR/../tools/ringenv/main.ring" ]; then
    RINGENV_DIR="$SCRIPT_DIR/../tools/ringenv"
elif [ -f "$SCRIPT_DIR/main.ring" ]; then
    RINGENV_DIR="$SCRIPT_DIR"
elif [ -f "$SCRIPT_DIR/../main.ring" ]; then
    RINGENV_DIR="$SCRIPT_DIR/.."
else
    echo "Error: Could not locate ringenv main.ring script."
    exit 1
fi

_SAVED_RINGPATH="$RINGPATH"
if [ -f "$SCRIPT_DIR/ring" ]; then
    RING_BIN="$SCRIPT_DIR/ring"
    export RINGPATH="$(cd "$SCRIPT_DIR/.." && pwd)"
else
    RING_BIN="ring"
fi

cd "$RINGENV_DIR"
"$RING_BIN" main.ring "$@"
EXIT_CODE=$?
cd "$RINGENV_CALLER_DIR"

export RINGPATH="$_SAVED_RINGPATH"

exit $EXIT_CODE
